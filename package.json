{
  "name": "dsh-session-notify",
  "version": "0.5.0",
  "description": "A bottom-right desktop card the moment a watched conversation finishes its turn: watch several sessions and get told when one is done, without keeping the window in front.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "popup.ps1",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "sessions",
    "notification",
    "toast",
    "desktop"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\"",
    "test:dom": "node --test \"test/client.logic.test.mjs\""
  },
  "license": "MIT",
  "author": "879745uhjun",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/879745uhjun/dsh-session-notify.git"
  },
  "homepage": "https://github.com/879745uhjun/dsh-session-notify#readme",
  "bugs": {
    "url": "https://github.com/879745uhjun/dsh-session-notify/issues"
  }
}
